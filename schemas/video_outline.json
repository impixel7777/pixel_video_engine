{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.ai/schemas/video_outline.json",
  "title": "PIXEL AI Video Outline",
  "description": "Stage 3 output: the structural plan for the long-form video. No narration prose.",
  "type": "object",
  "required": [
    "schema_version",
    "working_title",
    "target_duration_minutes",
    "target_word_count",
    "hook",
    "sections",
    "conclusion",
    "emotional_progression"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "working_title": {"type": "string", "minLength": 5},
    "target_duration_minutes": {"type": "number", "exclusiveMinimum": 0},
    "target_word_count": {"type": "integer", "minimum": 100},
    "hook": {
      "type": "object",
      "required": ["text", "purpose"],
      "additionalProperties": true,
      "properties": {
        "text": {"type": "string", "minLength": 15},
        "purpose": {"type": "string"},
        "duration_seconds": {"type": "number"}
      }
    },
    "introduction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "goal": {"type": "string"},
        "key_points": {"type": "array", "items": {"type": "string"}},
        "estimated_words": {"type": "integer"}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "key_points", "estimated_words"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]+$"},
          "title": {"type": "string", "minLength": 2},
          "goal": {"type": "string"},
          "key_points": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "examples": {"type": "array", "items": {"type": "string"}},
          "research_refs": {"type": "array", "items": {"type": "string"}},
          "transition_to_next": {"type": "string"},
          "estimated_words": {"type": "integer", "minimum": 40},
          "emotional_note": {"type": "string"},
          "visual_opportunities": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "conclusion": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": true,
      "properties": {
        "text": {"type": "string", "minLength": 15},
        "callback": {"type": "string"}
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": {"type": "string"},
        "placement": {"type": "string"}
      }
    },
    "emotional_progression": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "visual_opportunities": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
